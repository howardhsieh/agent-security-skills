.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# Local secrets
.env
.env.*
!.env.example

# Note: lockfiles (*.lock, *.lock.json, package-lock.json, uv.lock) are
# intentionally NOT ignored. Commit them.
