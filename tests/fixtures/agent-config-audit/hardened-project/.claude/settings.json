{
  "permissions": {
    "allow": ["Bash(npm run lint)"],
    "deny": ["Read(./secrets/**)"]
  },
  "disabledMcpjsonServers": ["experimental"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-env.sh" }
        ]
      }
    ]
  }
}
