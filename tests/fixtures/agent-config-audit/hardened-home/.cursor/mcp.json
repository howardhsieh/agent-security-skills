{
  "mcpServers": {
    "docs": {
      "command": "npx",
      "args": ["-y", "example-docs-mcp@1.2.3"],
      "env": { "API_KEY": "${env:EXAMPLE_API_KEY}" }
    },
    "remote": {
      "url": "https://mcp.example.com/mcp",
      "headers": { "Authorization": "Bearer ${env:MY_SERVICE_TOKEN}" }
    },
    "local-dev": {
      "url": "http://localhost:3000/mcp"
    }
  }
}
