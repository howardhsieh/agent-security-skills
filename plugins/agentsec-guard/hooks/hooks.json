{
  "description": "agentsec-guard: runtime guardrails for Claude Code. Local Python checks only; no network.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" pre || python \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" pre", "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" post || python \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" post", "timeout": 10}
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" session || python \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" session", "timeout": 20}
        ]
      }
    ]
  }
}
